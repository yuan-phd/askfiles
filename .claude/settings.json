{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/install_pkgs.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["SearchPlugins", "SuggestPluginInstall"]
  }
}
