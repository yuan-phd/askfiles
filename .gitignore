# dependencies and build outputs
node_modules/
dist/
out/
release/
*.dmg
*.tsbuildinfo

# local configuration and data
.env
.env.*
!.env.example
/storage/
/data/
/models/
resources/ollama*
*.log

# The patched, installed copy of upstream/ that dev runs, tests and packaging use (scripts/build.sh,
# scripts/lib/upstream-copy.mjs). upstream/ itself is vendored, tracked and never written to.
/upstream-build/

# Build output older versions of scripts/build.sh left inside upstream/; kept ignored so
# git clean -X upstream/ can remove it.
upstream/server/public/
upstream/frontend/dist/
upstream/collector/hotdir/*

# tests
test-results/
playwright-report/
coverage/

# editors and OS
.DS_Store
/.vscode/
.idea/

# evaluation harness: data directory kept between runs, run folders
/.eval-data/
/eval-runs/

# test build packages (scripts/package-test-build.sh)
release-test/
