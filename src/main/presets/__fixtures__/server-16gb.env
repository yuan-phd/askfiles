# Written by AskFiles on first run. The secrets are never rewritten; the first-run wizard and the
# model manager set the preset values (docs/presets.md).
# The ports record the first run only: the process manager allocates fresh ports at every
# start and passes them as environment variables, which take precedence over this file.
SERVER_PORT=3001
COLLECTOR_PORT=8888
JWT_SECRET="test-secret-1"
SIG_KEY="test-secret-2"
SIG_SALT="test-secret-3"
DISABLE_TELEMETRY="true"
# Preset 16gb (16 GB): starting values, phase 2 replaces them.
LLM_PROVIDER="ollama"
OLLAMA_BASE_PATH="http://127.0.0.1:11434"
OLLAMA_MODEL_PREF="qwen3:8b"
OLLAMA_MODEL_TOKEN_LIMIT="8192"
EMBEDDING_ENGINE="ollama"
EMBEDDING_BASE_PATH="http://127.0.0.1:11434"
EMBEDDING_MODEL_PREF="bge-m3:567m"
EMBEDDING_MODEL_MAX_CHUNK_LENGTH="2000"
VECTOR_DB="lancedb"
TARGET_OCR_LANG="eng,chi_sim"
DEFAULT_REASONING_EFFORT="off"
